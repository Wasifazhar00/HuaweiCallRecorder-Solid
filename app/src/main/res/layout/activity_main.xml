<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Solid Call Recorder"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Checking setup…"
            android:textSize="14sp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Setup checklist"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/checklistText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnPerms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Grant permissions"
            android:layout_marginBottom="4dp" />

        <Button
            android:id="@+id/btnBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. Unrestricted battery"
            android:layout_marginBottom="4dp" />

        <Button
            android:id="@+id/btnGetShizuku"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3. Get Shizuku-Next (optional)"
            android:layout_marginBottom="4dp" />

        <Button
            android:id="@+id/btnOpenShizuku"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="4. Open Shizuku-Next and start it"
            android:layout_marginBottom="4dp" />

        <Button
            android:id="@+id/btnShizuku"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="5. Authorize this app"
            android:layout_marginBottom="12dp" />

        <CheckBox
            android:id="@+id/chkAuto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Auto-record incoming and outgoing calls"
            android:checked="true"
            android:layout_marginBottom="4dp" />

        <CheckBox
            android:id="@+id/chkOfflineOnly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Offline only (Classic, no Shizuku)"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start manual recording"
            android:layout_marginBottom="4dp" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Stop recording"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/infoText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp" />
    </LinearLayout>
</ScrollView>
