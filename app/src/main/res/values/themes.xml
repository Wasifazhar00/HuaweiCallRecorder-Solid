<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SolidCallRecorder" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorOutline">@color/md_outline</item>
        <item name="colorError">@color/md_error</item>
        <item name="android:statusBarColor">@color/md_primary</item>
        <item name="android:navigationBarColor">@color/md_surface</item>
        <item name="android:windowBackground">@color/md_surface</item>
        <item name="android:fitsSystemWindows">true</item>
        <item name="materialButtonStyle">@style/Widget.Solid.Button</item>
    </style>

    <style name="Widget.Solid.Button" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Widget.Solid.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Widget.Solid.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">12dp</item>
    </style>
</resources>
